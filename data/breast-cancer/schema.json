{
  "name": "breast-cancer",
  "source": "sklearn.datasets.load_breast_cancer",
  "license": "CC BY 4.0",
  "rows": 569,
  "target": {
    "name": "diagnosis",
    "type": "binary",
    "classes": {"0": "malignant", "1": "benign"},
    "distribution": {"0": 212, "1": 357}
  },
  "columns": [
    {"name": "mean radius", "type": "numeric", "description": "Mean of distances from center to points on the perimeter"},
    {"name": "mean texture", "type": "numeric", "description": "Standard deviation of gray-scale values"},
    {"name": "mean perimeter", "type": "numeric", "description": "Mean perimeter of the cell nucleus"},
    {"name": "mean area", "type": "numeric", "description": "Mean area of the cell nucleus"},
    {"name": "mean smoothness", "type": "numeric", "description": "Local variation in radius lengths"},
    {"name": "mean compactness", "type": "numeric", "description": "Perimeter^2 / area - 1.0"},
    {"name": "mean concavity", "type": "numeric", "description": "Severity of concave portions of the contour"},
    {"name": "mean concave points", "type": "numeric", "description": "Number of concave portions of the contour"},
    {"name": "mean symmetry", "type": "numeric", "description": "Symmetry of the cell nucleus"},
    {"name": "mean fractal dimension", "type": "numeric", "description": "Coastline approximation - 1"},
    {"name": "radius error", "type": "numeric", "description": "Standard error of radius"},
    {"name": "texture error", "type": "numeric", "description": "Standard error of texture"},
    {"name": "perimeter error", "type": "numeric", "description": "Standard error of perimeter"},
    {"name": "area error", "type": "numeric", "description": "Standard error of area"},
    {"name": "smoothness error", "type": "numeric", "description": "Standard error of smoothness"},
    {"name": "compactness error", "type": "numeric", "description": "Standard error of compactness"},
    {"name": "concavity error", "type": "numeric", "description": "Standard error of concavity"},
    {"name": "concave points error", "type": "numeric", "description": "Standard error of concave points"},
    {"name": "symmetry error", "type": "numeric", "description": "Standard error of symmetry"},
    {"name": "fractal dimension error", "type": "numeric", "description": "Standard error of fractal dimension"},
    {"name": "worst radius", "type": "numeric", "description": "Worst (largest) value of radius"},
    {"name": "worst texture", "type": "numeric", "description": "Worst value of texture"},
    {"name": "worst perimeter", "type": "numeric", "description": "Worst value of perimeter"},
    {"name": "worst area", "type": "numeric", "description": "Worst value of area"},
    {"name": "worst smoothness", "type": "numeric", "description": "Worst value of smoothness"},
