{
  "name": "lizystudio-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/e2e/visual/",
    "test:e2e:update": "playwright test tests/e2e/visual/ --update-snapshots",
    "test:e2e:a11y": "playwright test tests/e2e/a11y/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "generate:api": "openapi-typescript http://localhost:8501/openapi.json -o src/api/generated/schema.d.ts",
    "check:api-types": "bash scripts/check-api-types.sh",
    "mutation:test": "stryker run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-deep-equal": "^3.1.3",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.33.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plotly.js": "^4.1.0",
    "react-resizable-panels": "^4",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/react": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@storybook/test-runner": "^0.24.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.15.0": ">=1.15.0",
      "axios@>=1.0.0 <1.15.1": ">=1.15.1",
      "axios@>=1.0.0 <1.15.2": ">=1.15.2",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "follow-redirects@<=1.15.11": ">=1.16.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1"
    }
  }
}
