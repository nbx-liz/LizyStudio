{
  "config_version": 1,
  "task": "binary",
  "data": {
    "path": "/path/to/data.csv",
    "target": "Survived",
    "time_col": null,
    "group_col": null
  },
  "features": {
    "exclude": [
      "PassengerId",
      "Sex",
      "Name"
    ],
    "auto_categorical": true,
    "categorical": [
      "Pclass",
      "SibSp",
      "Parch",
      "Embarked",
      "CabinDeck",
      "Ticket",
      "Cabin"
    ],
    "unseen_policy": "mode"
  },
  "split": {
    "method": "stratified_kfold",
    "n_splits": 5
  },
  "model": {
    "name": "lgbm",
    "params": {
      "objective": "binary",
      "metric": [
        "auc",
        "binary_logloss"
      ]
    },
    "auto_num_leaves": true,
    "num_leaves_ratio": 1,
    "min_data_in_leaf_ratio": 0.01,
    "min_data_in_bin_ratio": 0.01,
    "feature_weights": null,
    "balanced": null
  },
  "training": {
    "seed": 1120,
    "early_stopping": {
      "enabled": true,
      "rounds": 150,
      "inner_valid": {
        "method": "holdout",
        "ratio": 0.1,
        "stratify": false,
        "random_state": 42
      },
      "inner_valid_explicit": false
    }
  },
  "evaluation": {
    "metrics": [
      "auc",
      "accuracy",
      "auc_pr",
      "brier",
      "ece",
      "f1",
      "logloss",
      "precision_at_k"
    ]
  },
  "calibration": {
    "method": "isotonic",
    "n_splits": 5,
    "params": {}
  },
  "output_dir": null
}
